          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "engines": {
                    "type": "string",
                    "description": "Comma-separated: nudenet,nsfw,arachnid. Only on /v1/scan."
