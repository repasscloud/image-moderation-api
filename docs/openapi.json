  "components": {
    "schemas": {
      "Detection": {
        "properties": {
          "class": {
            "type": "string",
            "title": "Class"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "box": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Box"
          }
        },
        "type": "object",
        "required": [
          "class",
          "score",
          "box"
        ],
        "title": "Detection"
      },
      "EngineResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed",
              "disabled",
              "not_requested"
            ],
            "title": "Status"
          },
          "inference_time_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inference Time Ms"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          },
          "detections": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Detection"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detections"
          },
          "classification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Classification",
            "description": "Freepik library boolean or verbatim Shield classification string."
          },
          "is_nsfw": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Nsfw"
          },
          "probabilities": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": {
                    "type": "number"
                  },
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probabilities",
            "description": "Freepik original cumulative score dictionaries; not an exclusive class distribution."
          },
          "pdq_quality": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pdq Quality"
          },
          "match_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Match Type"
          },
          "raw": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "EngineResult"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Readiness": {
        "properties": {
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "engines": {
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ready",
                "failed",
                "disabled"
              ]
            },
            "propertyNames": {
              "enum": [
                "nudenet",
                "nsfw",
                "arachnid"
              ]
            },
            "type": "object",
            "title": "Engines"
          }
        },
        "type": "object",
        "required": [
          "ready",
          "engines"
        ],
        "title": "Readiness"
      },
      "ScanResponse": {
        "properties": {
          "scan_id": {
            "type": "string",
            "format": "uuid",
            "title": "Scan Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "partial",
              "failed"
            ],
            "title": "Status"
          },
          "filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename"
          },
          "processing_time_ms": {
            "type": "number",
            "title": "Processing Time Ms"
          },
          "results": {
            "additionalProperties": {
              "$ref": "#/components/schemas/EngineResult"
            },
            "propertyNames": {
              "enum": [
                "nudenet",
                "nsfw",
                "arachnid"
              ]
            },
            "type": "object",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "scan_id",
          "status",
          "filename",
          "processing_time_ms",
          "results"
        ],
        "title": "ScanResponse"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required on scan endpoints when API_KEY is configured."
      }
    }
  }
}