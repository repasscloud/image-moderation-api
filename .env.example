# Optional. Blank or whitespace disables authentication. Keep the service private.
API_KEY=
# Optional. Both required to enable Shield; partial credentials disable it.
ARACHNID_API_USERNAME=
ARACHNID_API_PASSWORD=
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
ENABLE_NUDENET=true
ENABLE_NSFW=true
MAX_IMAGE_SIZE_MB=20
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=8192
MAX_CONCURRENT_SCANS=1
UPLOAD_TIMEOUT_SECONDS=30
SCAN_TIMEOUT_SECONDS=120
ARACHNID_TIMEOUT_SECONDS=15
NUDENET_CONFIDENCE_THRESHOLD=0
NSFW_DTYPE=float32
MODEL_CACHE=model-cache
ENABLE_DOCS=true
