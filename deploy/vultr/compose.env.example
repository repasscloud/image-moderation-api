# Nonsecret settings only. Actual compose.env is ignored.
# Use a registry image built by build.sh, published explicitly, then pinned by digest.
PROCESSOR_IMAGE=registry.example.test/swoovr-image-processor@sha256:REPLACE_WITH_REVIEWED_DIGEST
PROCESSOR_BIND_IP=REPLACE_WITH_THIS_VM_PRIVATE_IP
PROCESSOR_ENV_FILE=/opt/swoovr-image/private/processor.env
PROCESSOR_CONTROL_DIR=/opt/swoovr-image/control
PROCESSOR_MEMORY=4g
PROCESSOR_CPUS=2
CLAMAV_MEMORY=4g
CLAMAV_CPUS=2
