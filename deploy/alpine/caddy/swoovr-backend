#!/bin/sh
# swoovr-backend — manage the Caddy round-robin pool of image-moderation processors.
#
#   swoovr-backend list                       pool members and their /ready status
#   swoovr-backend add <ip> [--force]         add a processor (must answer /ready 200 unless --force)
#   swoovr-backend remove <ip>                take a processor out (in-flight jobs finish first)
#   swoovr-backend replace <old> <new> [--force]   swap in one atomic reload
#   swoovr-backend render [--no-reload]       regenerate the Caddyfile from the pool file
#
# The pool lives in /etc/swoovr-caddy/backends (one VPC IPv4 per line). Every change is
# written to a temp file, validated by Caddy, then hot-reloaded; on any failure the previous
# pool and Caddyfile are kept.
set -eu
umask 022

ETC=${SWOOVR_CADDY_ETC:-/etc/swoovr-caddy}
CADDYFILE=${SWOOVR_CADDYFILE:-/etc/caddy/Caddyfile}
POOL=$ETC/backends
SETTINGS=$ETC/gateway.env
LOCK=$ETC/.lock

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,10s/^# \{0,1\}//p' "$0"; exit 2; }
conf_get() { awk -F= -v k="$1" '$1 == k { print substr($0, index($0, "=") + 1); exit }' "$SETTINGS"; }

valid_ipv4() {
    case "$1" in ''|*[!0-9.]*|.*|*.|*..*) return 1;; esac
    _old=$IFS; IFS=.
    # shellcheck disable=SC2086
    set -- $1
    IFS=$_old
    [ "$#" -eq 4 ] || return 1
    for _n do
        case "$_n" in 0?*) return 1;; esac
        [ "${#_n}" -le 3 ] && [ "$_n" -le 255 ] || return 1
    done
}

[ -r "$SETTINGS" ] || die "$SETTINGS not found; run the caddy installer first."
DOMAIN=$(conf_get DOMAIN)
PORT=$(conf_get BACKEND_PORT)
PORT=${PORT:-8080}
[ -n "$DOMAIN" ] || die "DOMAIN missing from $SETTINGS"
touch "$POOL" 2>/dev/null || [ -r "$POOL" ] || die "Cannot read $POOL"

in_pool() { grep -qxF "$1" "$POOL"; }
pool_size() { grep -c . "$POOL" || true; }

ready_code() {
    curl -s -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 15 \
        "http://$1:$PORT/ready" 2>/dev/null || true
}

require_ready() { # require_ready IP FORCE
    code=$(ready_code "$1")
    [ "$code" = 200 ] && return 0
    [ "$2" = 1 ] && { printf 'WARNING: %s /ready returned %s; adding anyway (--force). Caddy keeps it out of rotation until healthy.\n' "$1" "${code:-000}" >&2; return 0; }
    die "$1:$PORT/ready returned ${code:-000}, not 200. Fix the node (or its UFW rule for this gateway), or pass --force."
}

render() { # render POOLFILE -> stdout
    upstreams=$(awk -v p="$PORT" 'NF { printf "%s%s:%s", (n++ ? " " : ""), $1, p }' "$1")
    cat <<EOF
# Generated by swoovr-backend from $ETC — do not edit by hand.
# Change the pool with: swoovr-backend list|add|remove|replace
{
	# On reload (pool change), in-flight image jobs (up to 180s) finish on the old config.
	grace_period 200s
}

$DOMAIN {
	# Reject oversized uploads at the edge (processor accepts <=10 MiB images).
	request_body {
		max_size 12MB
	}

	@process {
		method POST
		path /v1/process
	}
	handle @process {
		# All client request headers (incl. Authorization) are forwarded unchanged, the
		# original Host is kept, and X-Forwarded-For/-Proto/-Host are added.
		# No retries: POST jobs are never replayed onto a second backend.
		reverse_proxy $upstreams {
			lb_policy round_robin

			health_uri /ready
			health_interval 10s
			health_timeout 5s
			health_status 200
			health_fails 2
			health_passes 2

			fail_duration 30s
			max_fails 1

			transport http {
				dial_timeout 5s
				response_header_timeout 180s
			}
		}
	}

	# Public health probes for uptime monitors. Each one is answered by a processor, so the
	# status reflects the pool, not just Caddy. HEAD is turned into GET because the
	# processors only route GET. GETs are idempotent, so a probe can retry on another
	# backend within 5s.
	#   GET /health -> 200 if at least one processor is alive (/health), otherwise 503
	#   GET /ready  -> 200 if at least one processor can take jobs (/ready), otherwise 503
	@health {
		method GET HEAD
		path /health
	}
	handle @health {
		method GET
		reverse_proxy $upstreams {
			lb_policy round_robin
			lb_try_duration 5s
			health_uri /health
			health_interval 10s
			health_timeout 5s
			health_status 200
			health_fails 2
			health_passes 2
			transport http {
				dial_timeout 3s
				response_header_timeout 5s
			}
		}
	}

	@ready {
		method GET HEAD
		path /ready
	}
	handle @ready {
		method GET
		reverse_proxy $upstreams {
			lb_policy round_robin
			lb_try_duration 5s
			health_uri /ready
			health_interval 10s
			health_timeout 5s
			health_status 200
			health_fails 2
			health_passes 2
			transport http {
				dial_timeout 3s
				response_header_timeout 5s
			}
		}
	}

	# /v1/engines, /docs and everything else stay private.
	handle {
		respond "Not Found" 404
	}
}
EOF
}

# commit NEWPOOL [--no-reload]: validate, swap in pool + Caddyfile, reload; roll back on failure.
commit() {
    newpool=$1 reload=${2:-}
    [ "$(grep -c . "$newpool" || true)" -ge 1 ] || { rm -f "$newpool"; die 'The pool cannot be empty.'; }
    mkdir -p "$(dirname "$CADDYFILE")"
    tmp=$(mktemp "$CADDYFILE.XXXXXX")
    render "$newpool" > "$tmp"
    if ! out=$(caddy validate --config "$tmp" --adapter caddyfile 2>&1); then
        printf '%s\n' "$out" >&2
        rm -f "$tmp" "$newpool"
        die 'Generated Caddyfile failed validation; nothing changed.'
    fi
    [ -f "$CADDYFILE" ] && cp -p "$CADDYFILE" "$CADDYFILE.prev"
    cp -p "$POOL" "$POOL.prev"
    chmod 644 "$tmp" "$newpool"
    mv "$tmp" "$CADDYFILE"
    mv "$newpool" "$POOL"
    if [ "$reload" != --no-reload ]; then
        if ! out=$(caddy reload --config "$CADDYFILE" --adapter caddyfile 2>&1); then
            printf '%s\n' "$out" >&2
            mv "$POOL.prev" "$POOL"
            [ -f "$CADDYFILE.prev" ] && mv "$CADDYFILE.prev" "$CADDYFILE"
            die 'Caddy reload failed; previous pool and Caddyfile restored (running config unchanged).'
        fi
        echo 'Caddy reloaded.'
    fi
    echo 'Pool:'
    sed 's/^/  /' "$POOL"
}

lock() {
    mkdir "$LOCK" 2>/dev/null || die "Another swoovr-backend is running (remove $LOCK if stale)."
    trap 'rmdir "$LOCK"' EXIT HUP INT TERM
}

cmd=${1-}
[ -n "$cmd" ] || usage
shift
force=0
args=''
for a do
    case "$a" in --force) force=1;; --no-reload) args="$args $a";; -*) usage;; *) args="$args $a";; esac
done
# shellcheck disable=SC2086
set -- $args

case "$cmd" in
    list)
        echo "Domain: $DOMAIN   (backends on port $PORT)"
        while IFS= read -r ip; do
            [ -n "$ip" ] || continue
            printf '  %-16s /ready %s\n' "$ip" "$(ready_code "$ip")"
        done < "$POOL"
        ;;
    add)
        [ "$#" -eq 1 ] || usage
        valid_ipv4 "$1" || die "Not a valid IPv4 address: $1"
        lock
        ! in_pool "$1" || die "$1 is already in the pool."
        require_ready "$1" "$force"
        new=$(mktemp "$POOL.XXXXXX"); cat "$POOL" > "$new"; echo "$1" >> "$new"
        commit "$new"
        ;;
    remove)
        [ "$#" -eq 1 ] || usage
        lock
        in_pool "$1" || die "$1 is not in the pool."
        [ "$(pool_size)" -gt 1 ] || die "$1 is the last backend; add its replacement first (or use replace)."
        new=$(mktemp "$POOL.XXXXXX"); grep -vxF "$1" "$POOL" > "$new" || true
        commit "$new"
        ;;
    replace)
        [ "$#" -eq 2 ] || usage
        valid_ipv4 "$2" || die "Not a valid IPv4 address: $2"
        lock
        in_pool "$1" || die "$1 is not in the pool."
        ! in_pool "$2" || die "$2 is already in the pool."
        require_ready "$2" "$force"
        new=$(mktemp "$POOL.XXXXXX")
        awk -v o="$1" -v n="$2" '$0 == o { print n; next } { print }' "$POOL" > "$new"
        commit "$new"
        ;;
    render)
        lock
        new=$(mktemp "$POOL.XXXXXX"); cat "$POOL" > "$new"
        commit "$new" "${1:-}"
        ;;
    *) usage;;
esac
